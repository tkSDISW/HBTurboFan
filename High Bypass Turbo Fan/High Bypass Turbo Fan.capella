            <ownedMinValue xsi:type="org.polarsys.capella.core.data.information.datavalue:LiteralNumericValue"
                id="a0c09178-de05-4a11-bbd9-7a15801634ff" name="" abstractType="#8271afda-ecfa-44ad-974d-08c662ebb14f"
