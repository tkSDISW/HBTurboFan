      </ownedExtensions>
      <ownedExtensions xsi:type="CapellaRequirements:CapellaModule" id="a1ce9b33-7d36-4174-a5c8-6de07cc24c87"
          ReqIFLongName="PLM Requirements" moduleType="#ce3362c7-1ef2-4824-bc43-e45d23738fb2">
        <ownedRequirements xsi:type="Requirements:Requirement" id="2932132b-b72c-43c1-bcd2-772afb6a5598"
            ReqIFLongName="Receive Air Capability" ReqIFPrefix="REQ-164175/A" requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability encompasses the essential processes required to intake air from the environment and prepare it for subsequent functions. It ensures that the air is properly received and designated for consumption by various downstream functions within the system. In aviation, this step is fundamental for maintaining optimal engine performance and efficiency.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Receive Air&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="db5830b0-095c-4ddf-835a-2e74b45436a7"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#81c7f931-541b-4651-b409-6d6cbf352092" target="#2932132b-b72c-43c1-bcd2-772afb6a5598"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="734a0ad3-8787-491e-95b7-b532571d7169"
            ReqIFLongName="Deliver Engine Thrust Capability" ReqIFPrefix="REQ-164137/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability involves the integration of functions responsible for generating and delivering thrust to the aircraft engine. This process is critical for propulsion, providing the necessary force to move the aircraft forward through air, which is one of the principal actions that enables flight.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Deliver Engine Thrust&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="e78fcaa5-f1f8-4b27-806b-3faa3de56bd0"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#2112bde6-e777-4e85-8332-c0ec69c99eb3" target="#734a0ad3-8787-491e-95b7-b532571d7169"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="9f0aedd5-63ed-49d6-94f4-3ea5e9366489"
            ReqIFLongName="Deliver Thrust Capability" ReqIFPrefix="REQ-164190/A" requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This comprehensive capability focuses on the delivery of thrust necessary for propelling the aircraft. It integrates various functions to optimize air and fuel flow, ensuring the engine can produce the required thrust efficiently and effectively throughout flight operations.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Deliver Thrust&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="86716117-741d-4a17-b40f-1619ef2b2a91"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#a878bccb-fdd5-4d79-b711-3a84e4395f87" target="#9f0aedd5-63ed-49d6-94f4-3ea5e9366489"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="077d7486-1b0e-4fae-9a94-0a75dc5df752"
            ReqIFLongName="Monitor Turbine Air Capability" ReqIFPrefix="REQ-164140/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability focuses on the functionality to monitor the air parameters at the turbine level, including temperature and pressure. Monitoring ensures engine safety and efficiency by providing real-time data for adjustments, helping prevent overheating and damage to turbine components.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor Turbine Air&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="2df26eb6-d59c-4570-9afe-cd3981471d3c"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#ef61b2e6-08ea-4eed-94e2-85045189a02a" target="#077d7486-1b0e-4fae-9a94-0a75dc5df752"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="94c5e74a-b32a-43dc-9868-620c23f6c63e"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#7c01a44e-8ecd-4fac-9cd1-c5ed0e811fab" target="#077d7486-1b0e-4fae-9a94-0a75dc5df752"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="65c44b6b-3847-4283-8863-bf67ff8c4d1a"
            ReqIFLongName="Deliver Fan Thrust Capability" ReqIFPrefix="REQ-164199/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability embodies the functions required to manage the air flow and thrust generated by the fan in turbofan engines. It involves the direction and control of air, maximizing the efficiency of the fan and reducing fuel consumption, which is vital for maintaining competitive aviation operations.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Deliver Fan Thrust&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="eec3b99a-58c1-4137-9552-3601b07d2afd"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#64e512ff-f6f1-42f1-a92c-1d65e8b9b4fd" target="#65c44b6b-3847-4283-8863-bf67ff8c4d1a"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="90c41efe-c489-4dcb-8960-715ebfd144c7"
            ReqIFLongName="Control Bleed Air Valve Capability" ReqIFPrefix="REQ-164156/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability involves managing the bleed air valves, which regulate air flow to various aircraft systems. Effective control is crucial for ensuring the proper functioning of pneumatic systems, such as air conditioning and pressurization, critical for comfortable and safe flight.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Control Bleed Air Valve&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="9020a629-c7b0-4959-a836-0cd57872891b"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#110faf01-6814-42df-87fb-6291f075bbc9" target="#90c41efe-c489-4dcb-8960-715ebfd144c7"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="d281312e-ed7f-441c-b807-de122eb9ddc9"
            ReqIFLongName="Monitor LP Stator Vanes Capability" ReqIFPrefix="REQ-164133/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability involves assessing and adjusting the Low-Pressure Stator Vane positions to optimize airflow through the LP compressor. This results in enhanced engine performance under different power settings and flight conditions.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor LP Stator Vanes&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="2117c1ea-6f58-4d2d-aeac-2a50f1704319"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#30b925ff-a187-4c6a-8837-ba2787d7b67a" target="#d281312e-ed7f-441c-b807-de122eb9ddc9"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="21052c2d-18e2-4b14-958e-c385c038d250"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#7bbbca5b-8957-496d-b090-4abda5528d01" target="#d281312e-ed7f-441c-b807-de122eb9ddc9"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="6d468019-6d34-4704-a97f-61d57776df89"
            ReqIFLongName="Monitor Inlet Pressure Capability" ReqIFPrefix="REQ-164163/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability involves monitoring the air pressure at various engine stages to ensure efficient engine performance. It helps in diagnosing potential issues that could affect the engine's performance and longevity, such as compressor stalls or surges, which are critical for maintaining flight safety.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor Inlet Pressure&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="60e3f3b0-6fff-4df9-af6e-4aa23798b76e"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#56460e13-55e2-4cb4-b691-f9dd472bc596" target="#6d468019-6d34-4704-a97f-61d57776df89"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="0255369e-8762-4185-a980-f6761c01ce1b"
            ReqIFLongName="Actuate LP Stator Vanes Capability" ReqIFPrefix="REQ-164167/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability involves the adjustment and control of Low-Pressure Stator Vanes, which are crucial for directing airflow through the engine's compressor sections. Proper vane angles ensure optimal airflow, enhancing engine efficiency and preventing unwanted aerodynamic losses that could affect engine performance.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Actuate LP Stator Vanes&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="4acee7fc-34b6-4242-8a17-541683b93580"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#b7d8db78-5f21-4e73-b860-0930de24e9a5" target="#0255369e-8762-4185-a980-f6761c01ce1b"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="e220b608-0a8b-4f61-b351-351bea2cbdec"
            ReqIFLongName="Perform LP Compression Capability" ReqIFPrefix="REQ-164149/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability is concerned with the compression of incoming air at low pressure, a fundamental process that enhances the density of air entering the combustion chamber. This step is crucial for achieving the desired pressure conditions that improve combustion efficiency.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Perform LP Compression&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="aae79981-65d3-4a6b-adde-6ea55b1b434b"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#39e26f5f-9e35-41aa-a19e-f74570fada58" target="#e220b608-0a8b-4f61-b351-351bea2cbdec"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="4fcbcc0e-7557-419f-a90d-9a3b09bcb3c7"
            ReqIFLongName="Quito Airport High Altitude" ReqIFPrefix="REQ-164138/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>At an altitude of approximately [2,806 meters] and temperature of [15°C], the engine shall deliver maximum thrust to ensure takeoff under reduced air pressure conditions.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="c4193ac0-f347-4f91-a776-d3408ed16b84"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#30b925ff-a187-4c6a-8837-ba2787d7b67a" target="#4fcbcc0e-7557-419f-a90d-9a3b09bcb3c7"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="0582df03-1c8b-47cd-b1c5-3ce5480f1927"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#a878bccb-fdd5-4d79-b711-3a84e4395f87" target="#4fcbcc0e-7557-419f-a90d-9a3b09bcb3c7"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="6f8413b3-7b55-4459-91df-9f317a6a43d6"
            ReqIFLongName="Mumbai Airport Monsoon Climate" ReqIFPrefix="REQ-164197/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>At sea level with high ambient humidity and temperatures of approximately [35°C], the engine shall support maximum thrust for takeoff amid wet conditions.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="4220e64e-b11b-4cf8-9e17-1754bdc2abbd"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#30b925ff-a187-4c6a-8837-ba2787d7b67a" target="#6f8413b3-7b55-4459-91df-9f317a6a43d6"/>
