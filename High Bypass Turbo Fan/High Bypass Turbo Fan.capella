    <ownedExtensions xsi:type="re:GroupingElementPkg" id="65da8d71-60a8-4482-8d1d-5766f6b3fb3a"
        name="PLM Data">
      <ownedExtensions xsi:type="CapellaRequirements:CapellaTypesFolder" id="49a0760e-d901-402c-83f7-58a0148a452c"
          ReqIFLongName="PLM Requirement Types">
        <ownedTypes xsi:type="Requirements:ModuleType" id="ce3362c7-1ef2-4824-bc43-e45d23738fb2"
            ReqIFIdentifier="SMW_DEFAULT_PLM_REQ_MODULE" ReqIFLongName="PLM Requirement Module"/>
        <ownedTypes xsi:type="Requirements:RequirementType" id="d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFIdentifier="PlmRequirement" ReqIFLongName="PlmRequirement"/>
        <ownedTypes xsi:type="Requirements:RelationType" id="6d1ee22f-e172-4be5-bd21-9246c4d76d78"
            ReqIFIdentifier="TraceLink" ReqIFLongName="TraceLink"/>
        <ownedTypes xsi:type="Requirements:RelationType" id="998c37f0-0361-47fe-8439-1d069ac24605"
            ReqIFIdentifier="Derive" ReqIFLongName="Derive"/>
        <ownedTypes xsi:type="Requirements:RelationType" id="17c3e886-8be6-4ebe-be57-799a277e01f0"
            ReqIFIdentifier="Refine" ReqIFLongName="Refine"/>
        <ownedTypes xsi:type="Requirements:RelationType" id="c45e3109-3b40-4cfc-9fae-ace225f49840"
            ReqIFIdentifier="Satisfy" ReqIFLongName="Satisfy"/>
        <ownedTypes xsi:type="Requirements:RelationType" id="8f50247a-c182-4f7a-b993-1031dc1eee22"
