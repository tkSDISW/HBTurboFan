            ReqIFLongName="Ensure Engine Restart Capability" ReqIFPrefix="REQ-164191/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>The engine shall be capable of being restarted successfully within [J] seconds after shutdown under all approved conditions.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="0a4ce952-2338-4cda-8633-8a194e27707e"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c22f220a-34ad-4e28-baa9-ded79bce183a" target="#4a88cbf2-5d84-48b4-9d93-27c24e1a7210"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="ee80864c-272b-4a42-856c-04ae816198d3"
            ReqIFLongName="Sustain Reliable Operation" ReqIFPrefix="REQ-164154/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>The engine shall achieve a minimum &lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>mean time&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;> between failures (MTBF) of [I] hours under normal conditions.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="0117e6fc-788d-4ccb-849c-70f03773eb45"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c22f220a-34ad-4e28-baa9-ded79bce183a" target="#ee80864c-272b-4a42-856c-04ae816198d3"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="08a0a309-3a96-4eaa-bb55-7ee554c66f05"
            ReqIFLongName="Maintain Component Durability" ReqIFPrefix="REQ-164130/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:6pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>All major engine components shall withstand operational stressors for a lifespan of no less than [S] cycles before requiring replacement.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="b3980dc8-8bc8-4f91-ba1f-020d6e08714d"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c22f220a-34ad-4e28-baa9-ded79bce183a" target="#08a0a309-3a96-4eaa-bb55-7ee554c66f05"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="0b46ccc4-643f-4e22-9873-a4ff4577889a"
            ReqIFLongName="Support Altitude Operation Limits" ReqIFPrefix="REQ-164182/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>The engine shall maintain performance within [C]° of optimal thrust at altitudes of up to [D] feet.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="a9537b9f-85f1-484a-947f-36047bb79329"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c22f220a-34ad-4e28-baa9-ded79bce183a" target="#0b46ccc4-643f-4e22-9873-a4ff4577889a"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="6e77327b-ea5f-4ae9-90aa-1386e68e7503"
            ReqIFLongName="Achieve Required Thrust Output" ReqIFPrefix="REQ-164194/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>The engine shall deliver a thrust output not less than [X] Newtons under standard operational conditions.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="7b8ada5e-0a93-4fa9-a4a8-c54fee20823e"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c22f220a-34ad-4e28-baa9-ded79bce183a" target="#6e77327b-ea5f-4ae9-90aa-1386e68e7503"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="58d218b4-833f-435c-88a6-63ddd02f999a"
            ReqIFLongName="Maintain Thrust Reverser Functionality" ReqIFPrefix="REQ-164171/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>The thrust reverser system shall activate within [K] seconds upon command to ensure effective landing deceleration.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="44922b63-dae0-43c7-80d3-6529962c3577"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c22f220a-34ad-4e28-baa9-ded79bce183a" target="#58d218b4-833f-435c-88a6-63ddd02f999a"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="2baa9173-c3e8-4916-b7f8-4165b107992f"
            ReqIFLongName="Guarantee Response Time" ReqIFPrefix="REQ-164139/A" requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>The engine shall respond to throttle input changes within [M] milliseconds for pilot and system commands.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="bf96cb01-cc57-4a8d-89b3-e4e36581eb16"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c22f220a-34ad-4e28-baa9-ded79bce183a" target="#2baa9173-c3e8-4916-b7f8-4165b107992f"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="9cc49a09-6a1a-4665-a36c-bade3b3f2dd0"
            ReqIFLongName="Maintain Fuel Efficiency" ReqIFPrefix="REQ-164147/A" requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>The engine shall operate with a fuel consumption rate not exceeding [Y] kg/&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>hr&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;> at cruise conditions.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="13aa88c6-9a2e-40cf-a31d-85d0ff0d285c"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c22f220a-34ad-4e28-baa9-ded79bce183a" target="#9cc49a09-6a1a-4665-a36c-bade3b3f2dd0"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="a86e0ef5-19dc-4ac2-9008-23796ce11799"
            ReqIFLongName="Ensure Temperature Stability" ReqIFPrefix="REQ-164189/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>The exhaust gas temperature shall not exceed [A] °C to ensure optimal engine performance.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="f2981351-57cb-44c8-9b72-17505a1fb2d8"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c22f220a-34ad-4e28-baa9-ded79bce183a" target="#a86e0ef5-19dc-4ac2-9008-23796ce11799"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="00eff88d-dfa7-49e2-b7d3-c02dca77d7b8"
            ReqIFLongName="Monitor HP Stator Vane Position Capability" ReqIFPrefix="REQ-164132/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability focuses on monitoring the positions of High-Pressure Stator Vanes, ensuring they are correctly aligned to maximize compression efficiency and prevent complications arising from unoptimized airflow through the high-pressure compressor stages.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor HP Stator Vane Position&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="c1e23a39-5a62-4456-9992-3547ae5afa85"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#c315a7cd-5c39-43a4-87d7-591d38adc07a" target="#00eff88d-dfa7-49e2-b7d3-c02dca77d7b8"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="5e9bb002-882f-4347-9b13-f7dc630529b8"
            ReqIFLongName="Monitor LPC Discharge Pressure Capability" ReqIFPrefix="REQ-164192/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability centers around the observation and regulation of low-pressure compressor discharge pressure. It's key for optimizing the compression process, which impacts the engine's efficiency and power output, ensuring a balanced fuel-to-air mixture necessary for effective combustion.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor LPC Discharge Pressure&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="d63ad5c5-f492-48d9-a719-d226b13665d5"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#cfeeeab8-35e7-4d10-b347-f6365c4e8f99" target="#5e9bb002-882f-4347-9b13-f7dc630529b8"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="a73f66b8-128f-4b0b-84c3-618b03a12a0d"
            ReqIFLongName="Monitor HPC Discharge Pressure Capability" ReqIFPrefix="REQ-164188/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability focuses on evaluating the high-pressure compressor's discharge pressure, ensuring it stays within operational limits. It is paramount for maintaining the high-pressure ratio necessary for maximum thrust and efficient fuel consumption, which are vital attributes for modern jet engines.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor HPC Discharge Pressure&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="0992a9a0-a0e2-4766-995c-c7b648d61891"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#2eb72a0a-89e7-4f9e-8d86-eed638abaf44" target="#a73f66b8-128f-4b0b-84c3-618b03a12a0d"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="1621969d-d1dc-4041-bfe8-bb115eab9604"
            ReqIFLongName="Actuate HP Stator Vanes Capability" ReqIFPrefix="REQ-164169/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability is vital for controlling and maneuvering the High-Pressure Stator Vanes. These vanes adjust airflow entering the high-pressure compressor, playing a significant role in maximizing efficiency and minimizing engine stress during various operating conditions.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Actuate HP Stator Vanes&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="212474f3-8256-4cc4-b4b7-fa7d97d12f2e"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#30b925ff-a187-4c6a-8837-ba2787d7b67a" target="#1621969d-d1dc-4041-bfe8-bb115eab9604"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="ad8bafaf-b916-4a1e-b753-e5906565c998"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#af913d40-f26b-41fb-bc29-160f78e1523c" target="#1621969d-d1dc-4041-bfe8-bb115eab9604"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="d53f13a4-4231-414c-8541-3412a9f96ce2"
            ReqIFLongName="Perform HP Compression Capability" ReqIFPrefix="REQ-164159/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability involves compressing air at high pressure, which is necessary for increasing the overall efficiency and thrust of the engine. It's a critical operational aspect of jet engines, optimizing airflow and pressure ratios to deliver high performance.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Perform HP Compression&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="15a3e3d9-bb75-40fd-8653-cccb7f4b4a6f"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#7a3c1a20-c7ff-43d6-bb52-8d26483898df" target="#d53f13a4-4231-414c-8541-3412a9f96ce2"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="8ead0c4a-4dc4-48b1-a827-f34e33aba90b"
            ReqIFLongName="Combust Fuel Capability" ReqIFPrefix="REQ-164177/A" requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability encompasses the combustion processes within the engine, where the fuel-air mixture is burned to produce power. Effective combustion is essential for converting chemical energy into mechanical energy efficiently, which powers the engine to propel the aircraft.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Combust Fuel&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="867088fe-000d-476d-b9b8-2f7682785e9c"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#63932112-45ff-4be2-976e-257aab331867" target="#8ead0c4a-4dc4-48b1-a827-f34e33aba90b"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="637a6f4b-9352-4981-a853-1c0c7a065659"
            ReqIFLongName="Control Fuel Capability" ReqIFPrefix="REQ-164135/A" requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability manages the flow of fuel to the engine to ensure optimal combustion. Precise fuel control directly correlates to engine efficiency, reduced emissions, and a prolonged life span of engine components by preventing situations such as fuel starvation or over-rich mixtures.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Control Fuel&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="dc0f684f-25aa-458c-bfb6-e5f1b5e981b1"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#a7b36c2d-8304-46b6-9ff4-af3318b75b17" target="#637a6f4b-9352-4981-a853-1c0c7a065659"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="34958894-36d4-44b9-9c44-194d48755f2f"
            ReqIFLongName="Monitor Combustion Chamber Pressure Capability" ReqIFPrefix="REQ-164193/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability includes the functions associated with monitoring pressure within the combustion chamber. It is pivotal for ensuring stable combustion and preventing backfires or compressor stalls, thus protecting the engine from damage and ensuring smooth operation.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor Combustion Chamber Pressure&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="9349c37b-849a-4c87-90f4-b3bda13359d1"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#b2669099-4f46-42c5-8cb0-9334a0627ebb" target="#34958894-36d4-44b9-9c44-194d48755f2f"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="5ac4cca5-c146-4d76-b7a5-949b36423782"
            ReqIFLongName="Measure FMV Position Capability" ReqIFPrefix="REQ-164165/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability is concerned with the precise measurement and control of the Fuel Metering Valve position, imperative for managing fuel flow to the engine. Accurate positioning ensures efficient fuel &lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>burn&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;> and assists in reducing emissions.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Measure FMV Position&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="1842a5a7-b32c-49ba-8087-fca60d5dc572"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#4b5cc4c8-6af6-410a-a1b6-e76d3be3f549" target="#5ac4cca5-c146-4d76-b7a5-949b36423782"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="0b9ef3d7-f219-41f3-9206-f1fcde56ccb0"
            ReqIFLongName="Monitor N2 Capability" ReqIFPrefix="REQ-164174/A" requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Monitoring N2 involves functions that assess the rotational speed of the high-pressure compressor shaft. Precise N2 monitoring is fundamental for controlling engine performance and ensuring it operates within safe and efficient parameters across different flight conditions.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor N2&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="182a18cc-d498-4f5e-9936-aae4b8c13c68"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#f5b04367-19ca-4833-9799-c76f4969c97e" target="#0b9ef3d7-f219-41f3-9206-f1fcde56ccb0"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="0239adf1-09f5-4574-a331-1c98781f3f66"
            ReqIFLongName="Monitor HPT Outlet Pressure Capability" ReqIFPrefix="REQ-164164/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability &lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>involves the&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;> &lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>observation of&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;> the outlet pressure of the High-Pressure Turbine. It's crucial for ensuring the correct pressure gradient for turbine efficiency, connecting to the overall control system to adapt for optimal engine performance and stability.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor HPT Outlet Pressure&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="40bc1660-d623-4afe-ae3e-b7292a011a6a"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#30f93f3f-4a07-4708-8036-0b598c918a2f" target="#0239adf1-09f5-4574-a331-1c98781f3f66"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="598a7835-e580-4a33-a8c5-003f27bfacd8"
            ReqIFLongName="Extract HP Turbine Energy Capability" ReqIFPrefix="REQ-164170/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability refers to harnessing the energy from high-pressure turbines. It's crucial for converting thermal energy into mechanical energy, providing the necessary rotational power that drives compressors and other engine components, which contributes significantly to the engine's thrust generation.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Extract HP Turbine Energy&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="11afe715-1263-4cd9-936c-ce9f0bdcab27"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#781670cd-b6db-4de7-b687-f275241fa71d" target="#598a7835-e580-4a33-a8c5-003f27bfacd8"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="53685bd8-c537-43c1-a058-ca6496e2f264"
            ReqIFLongName="Monitor EGT Capability" ReqIFPrefix="REQ-164146/A" requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>The Exhaust Gas Temperature (EGT) is monitored to obtain critical insights into engine health and efficiency. Ensuring EGT stays within design limits is imperative for preventing thermal stress that could result in damage to the engine or associated components.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor EGT&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="2b419ae1-bfba-4a97-b73a-291f8ad8da06"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#8c2a6a0c-276d-4d4c-ac85-ba37704b45c4" target="#53685bd8-c537-43c1-a058-ca6496e2f264"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="04a77411-713d-4985-9da5-40a7f385979b"
            ReqIFLongName="LP Turbine to Shaft Capability" ReqIFPrefix="REQ-164127/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability refers to the transmission of mechanical energy from the Low-Pressure Turbine to the shaft, driving the fan and low-pressure compressor. It's critical for maintaining the propulsion efficiency and thrust generation capabilities of the entire propulsion system.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: LP Turbine to Shaft&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="e7d85b0a-b833-48e6-90cc-50c9f0f1a095"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#80746594-cb46-4ee9-918d-963bd7bd5668" target="#04a77411-713d-4985-9da5-40a7f385979b"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="7c63af01-653e-4185-8d87-e4904ad39d29"
            ReqIFLongName="Monitor HP Pressure Capability" ReqIFPrefix="REQ-164179/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>This capability focuses on the surveillance of high-pressure conditions within the engine to ensure optimal operation. It helps in protecting against potential &lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>damages&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;> due to excessive pressures and assists in sustaining engine efficiency and reliability.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor HP Pressure&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="7d228c00-bd28-4ce4-85e7-13b83b1734eb"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#4d3e5b56-9212-46b9-bb5f-a7cff9d9ea78" target="#7c63af01-653e-4185-8d87-e4904ad39d29"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="18764c7a-e25c-49f7-a84c-4d05854f7138"
            ReqIFLongName="Monitor N1 Capability" ReqIFPrefix="REQ-164162/A" requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b"
            ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Monitoring N1, the rotational speed of the low-pressure compressor, is vital for tuning engine performance and maintaining the balance between thrust and fuel consumption. It supports sustained efficiency across varying power demands during &lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>flight&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>.&lt;/span>&lt;/p>&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Functional Chain: Monitor N1&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="229e7fe8-05c8-4354-8b3e-57bc62d5f612"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#2e195f49-8fc9-4f6d-be09-cd665657e276" target="#18764c7a-e25c-49f7-a84c-4d05854f7138"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="9887eeac-1043-4ba7-b479-4a6e0664d56b"
            ReqIFLongName="Fan Efficiency Requirement" ReqIFPrefix="REQ-164407/A"
            requirementType="#d94d58c1-3bbd-4a22-beb8-aaf2284e322b" ReqIFText="&lt;p style=&quot;margin-top:0pt;  margin-bottom:12pt;  font-size:10.5px;  background-color:#ffffff; &quot;>&lt;span style=&quot;font-family:'Segoe UI'&quot;>Logical component&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;> &lt;/span>&lt;span style=&quot;font-family:'Segoe UI'; font-weight:bold&quot;>Fan&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;> &lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>shall deliver η = 0.92 producing the high&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>‑&lt;/span>&lt;span style=&quot;font-family:'Segoe UI'&quot;>velocity fan air that generates bypass thrust for the engine.&lt;/span>&lt;/p>">
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="039a82b3-02e2-48d9-a8c3-9f6dc796acbf"
              relationType="#c45e3109-3b40-4cfc-9fae-ace225f49840" relationTypeProxy="Satisfy"
              source="#abfe9554-b63f-4bc3-852f-ac8167d666b8" target="#9887eeac-1043-4ba7-b479-4a6e0664d56b"/>
        </ownedRequirements>
      </ownedExtensions>
    </ownedExtensions>
